{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CesiumGS/cesium/main/Specs/Data/Performance/Decompression/benchmark-result-identity.schema.json",
  "title": "CesiumJS codec benchmark result identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "fixture",
    "browserRevision",
    "hardwareConcurrency",
    "decoderArtifacts",
    "queueDepth",
    "state"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "browserRevision": {
      "type": "string",
      "minLength": 1
    },
    "hardwareConcurrency": {
      "type": "integer",
      "minimum": 1
    },
    "decoderArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": ["module", "wasm"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "queueDepth": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": ["cold", "warm"]
    },
    "browserName": {
      "type": "string",
      "minLength": 1
    },
    "browserVersion": {
      "type": "string",
      "minLength": 1
    },
    "decoderPackage": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
